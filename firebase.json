{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/.well-known/ard.json/**",
        "destination": "/$1"
      },
      {
        "source": "/.well-known/favicon.ico/**",
        "destination": "/$1"
      },
      {
        "source": "**/*",
        "destination": "/index.html"
      }
    ]
  }
}